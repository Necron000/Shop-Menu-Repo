meta {
  name: "Iyzico Shop"
  type: "http"
  seq: 1
}

get {
  url: "http://localhost:8080/api/items"
  name: "Get items"
}

---

meta {
  name: "Admin create item"
  type: "http"
  seq: 2
}

post {
  url: "http://localhost:8080/api/admin/items"
  body: "json"
  auth: {
    mode: "basic"
    username: "admin"
    password: "admin123"
  }
}

body:json {
  {
    "name": "Laptop",
    "description": "Gaming laptop",
    "price": 22000.00,
    "currency": "TRY",
    "stock": 5
  }
}

---

meta {
  name: "User buy item"
  type: "http"
  seq: 3
}

post {
  url: "http://localhost:8080/api/users/buy"
  body: "json"
  auth: {
    mode: "basic"
    username: "user"
    password: "user123"
  }
}

body:json {
  {
    "itemId": 1,
    "buyerEmail": "user@example.com",
    "quantity": 2
  }
}

---

meta {
  name: "User get orders"
  type: "http"
  seq: 4
}

get {
  url: "http://localhost:8080/api/orders"
  auth: {
    mode: "basic"
    username: "user"
    password: "user123"
  }
}

---

meta {
  name: "Callback approved"
  type: "http"
  seq: 5
}

post {
  url: "http://localhost:8080/api/payments/callback"
  body: "json"
}

body:json {
  {
    "orderId": 1,
    "approved": true,
    "transactionId": "SIM-1",
    "message": "Iyzico simulation approved"
  }
}
